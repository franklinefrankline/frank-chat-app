# ==============================================================================
# FRANK - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
DATABASE_URL=sqlite:///./chatapp.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
SECRET_KEY=your-production-secret-key-at-least-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=https://frank-chat-app.vercel.app
CORS_ORIGINS=https://frank-chat-app.vercel.app,https://frank-chat-vercel.app,http://localhost:8000,http://localhost:3000
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=FRANK <noreply@your-domain.com>
MAX_FILE_SIZE_MB=25
MAX_DOCUMENT_SIZE_MB=25
MAX_VIDEO_SIZE_MB=50
UPLOAD_DIRECTORY=uploads
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
