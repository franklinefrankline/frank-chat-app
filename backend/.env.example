# ==============================================================================
# FRANK - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Primary Production Database: Railway PostgreSQL
# Example Railway: postgresql://postgres:password@roundhouse.proxy.rlwy.net:PORT/railway
# For local dev fallback: sqlite:///./chatapp.db
DATABASE_URL=sqlite:///./chatapp.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
SECRET_KEY=your-production-secret-key-at-least-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=https://frank-chat-app.vercel.app
CORS_ORIGINS=https://frank-chat-app.vercel.app,http://localhost:8000,http://localhost:3000
MAX_FILE_SIZE_MB=25
MAX_DOCUMENT_SIZE_MB=25
MAX_VIDEO_SIZE_MB=50
UPLOAD_DIRECTORY=uploads
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# ==============================================================================
# GMAIL SMTP EMAIL CONFIGURATION (FRANK Think)
# ==============================================================================
# Host: smtp.gmail.com
# Port: 587 (STARTTLS)
# Connection Security: STARTTLS (SMTP_SECURE=false)
# User: Your complete Gmail address (e.g., yourname@gmail.com)
# Pass: Your 16-character Google App Password (generated at https://myaccount.google.com/apppasswords)
# From: Your complete Gmail address or custom sender address
# From Name: FRANK Think
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=FRANK Think

# ==============================================================================
# GOOGLE OAUTH 2.0 CONFIGURATION (FRANK Think)
# ==============================================================================
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
# Authorized JavaScript Origins:
#   - https://fnk.vercel.app
#   - http://localhost:8000
# Authorized Redirect URIs:
#   - https://fnk.vercel.app/api/auth/google/callback
#   - http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=
# Optional: Comma-separated list of allowed domains (leave empty to allow personal Gmail and all Workspace accounts)
GOOGLE_ALLOWED_DOMAINS=
