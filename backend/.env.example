# ChatApp Configuration Template
SECRET_KEY=your_secure_random_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default SQLite:
DATABASE_URL=sqlite:///./chatapp.db
# PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/chatapp_db

# Server Config
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=*

# Document & File Upload Configuration
MAX_FILE_SIZE_MB=25
UPLOAD_DIRECTORY=uploads
