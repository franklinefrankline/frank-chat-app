# ==============================================================================
# FRANK - ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT place real secrets in this template or commit real .env files to Git.
# ==============================================================================

# Primary Production Database: Railway PostgreSQL
# Example Railway: postgresql://postgres:password@roundhouse.proxy.rlwy.net:PORT/railway
# For local dev fallback: sqlite:///./chatapp.db
DATABASE_URL=sqlite:///./chatapp.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# JWT & Cryptographic Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-production-secret-key-at-least-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Environment Mode
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# CORS & Frontend Origins (comma-separated without trailing slash)
FRONTEND_URL=https://frank-chat-vercel.app
CORS_ORIGINS=https://frank-chat-vercel.app,https://frank-chat-vercel.vercel.app,http://localhost:8000,http://localhost:3000

# File & Media Upload Limits (in Megabytes)
MAX_FILE_SIZE_MB=25
MAX_DOCUMENT_SIZE_MB=25
MAX_VIDEO_SIZE_MB=50
UPLOAD_DIRECTORY=uploads

# Persistent Cloud Object Storage (Optional: AWS S3, Cloudflare R2, Supabase)
# Leave empty for local filesystem storage
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
